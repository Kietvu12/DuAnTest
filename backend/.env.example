PORT=4000
HOST=127.0.0.1
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/duantest
JWT_SECRET=change-me
CORS_ORIGIN=http://localhost:5174

# --- TicketForge: gửi lỗi sang https://ticketforge.vietdemo.com để agent tự sửa code ---
# Địa chỉ backend gọi tới. Cùng server với TicketForge thì dùng http://127.0.0.1:3154
TICKETFORGE_URL=https://ticketforge.vietdemo.com
TICKETFORGE_PUBLIC_URL=https://ticketforge.vietdemo.com
# Địa chỉ công khai của site này. Domain phải được thêm ở TicketForge -> Cài đặt -> API.
PUBLIC_URL=http://localhost:5174
# Tạo ở TicketForge -> Cài đặt -> API (chỉ hiện một lần). Để trống: lỗi vẫn được lưu và tự gửi sau.
TICKETFORGE_API_KEY=
# Secret ký webhook (whsec_...). Webhook URL: <PUBLIC_URL>/api/ticketforge/webhook
TICKETFORGE_WEBHOOK_SECRET=
